{
	"name": "simple-popup",
	"version": "0.2.1",
	"description": "A lightweight, generic WordPress plugin for editor-managed popup windows.",
	"private": true,
	"license": "MIT",
	"author": "Jensen SIU",
	"scripts": {
		"preversion": "node bin/release.mjs check",
		"version": "node bin/release.mjs sync && npm run build && git add simple-popup.php readme.txt CHANGELOG.md src build",
		"postversion": "git push --follow-tags",
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"simple-popup.php",
		"includes",
		"build",
		"languages",
		"README.md",
		"readme.txt",
		"LICENSE",
		"CHANGELOG.md"
	],
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0"
	}
}
