#: includes/class-simple-popup-editor.php:47
msgid "Other language versions of this popup, for the editor sidebar."
msgstr ""
"Les autres versions de langue de cette fenêtre, pour le panneau de l'éditeur."

#: includes/class-simple-popup-editor.php:60
msgid ""
"Other published and active popups in the same language, for conflict "
"detection in the editor sidebar."
msgstr ""
"Les autres fenêtres publiées et actives de la même langue, pour détecter les "
"conflits dans le panneau de l'éditeur."

#: includes/class-simple-popup-editor.php:73
msgid ""
"URL that opens this popup alone, immediately, without reading or writing its "
"cookie."
msgstr ""
"Adresse qui ouvre cette fenêtre seule, immédiatement, sans lire ni écrire "
"son cookie."

#: includes/class-simple-popup-frontend.php:214
msgid "Close"
msgstr "Fermer"

#: includes/class-simple-popup-settings.php:38
msgid "Popups settings"
msgstr "Réglages des fenêtres"

#: includes/class-simple-popup-settings.php:39
msgid "Settings"
msgstr "Réglages"

#: includes/class-simple-popup-settings.php:61
msgid "Pause between two popups (seconds)"
msgstr "Pause entre deux fenêtres (secondes)"

#: includes/class-simple-popup-settings.php:80
msgid ""
"Minimum number of seconds between the closing of one popup and the opening "
"of the next, on the same page. A popup whose moment arrives earlier simply "
"waits: it opens as soon as the pause ends. 0 means no pause."
msgstr ""
"Nombre minimal de secondes entre la fermeture d'une fenêtre et l'ouverture "
"de la suivante, sur une même page. Une fenêtre dont le moment arrive plus "
"tôt attend simplement : elle s'ouvre dès la fin de la pause. 0 = pas de "
"pause."

#. translators: 1: title of the other popup, 2: pause in seconds.
#: build/editor.js:7 src/editor/index.js:162
msgid ""
"Less than %2$d s apart from \"%1$s\": whichever opens second will wait %2$d "
"s after the first one closes."
msgstr ""
"Moins de %2$d s d'écart avec « %1$s » : la seconde à s'ouvrir attendra %2$d "
"s après la fermeture de la première."

#. translators: %s: title of the other popup.
#: build/editor.js:8 src/editor/index.js:144
msgid ""
"Same moment as \"%s\": the first one in the list order opens first, the "
"other one then."
msgstr ""
"Même moment que « %s » : la première dans l'ordre de la liste s'ouvre "
"d'abord, l'autre ensuite."

#: build/editor.js:8 src/editor/index.js:223
msgid "Popup settings"
msgstr "Réglages de la fenêtre"

#: build/editor.js:8 src/editor/index.js:227
msgid "Only a published and active popup is displayed on the front end."
msgstr "Seule une fenêtre publiée et active est affichée sur le site."

#: build/editor.js:8 src/editor/index.js:239
msgid "Shared by all languages"
msgstr "Commun à toutes les langues"

#: build/editor.js:8 src/editor/index.js:263
msgid "Preview opens right away, ignoring the trigger and delay."
msgstr ""
"L'aperçu s'ouvre tout de suite, sans tenir compte du déclenchement ni du "
"délai."

#: build/editor.js:8 src/editor/index.js:278
msgid "Trigger"
msgstr "Déclenchement"

#: build/editor.js:8 src/editor/index.js:282
msgid "First gesture"
msgstr "Premier geste"

#: build/editor.js:8 src/editor/index.js:285
msgid "Page load"
msgstr "Chargement de la page"

#: build/editor.js:8 src/editor/index.js:287
msgid "Exit intent"
msgstr "Intention de sortie"

#: build/editor.js:8 src/editor/index.js:300
msgid "Delay (seconds)"
msgstr "Délai (secondes)"

#: build/editor.js:8 src/editor/index.js:311
msgid "Frequency"
msgstr "Fréquence"

#: build/editor.js:8 src/editor/index.js:315
msgid "Once per visit"
msgstr "Une fois par visite"

#: build/editor.js:8 src/editor/index.js:319
msgid "Every N hours"
msgstr "Toutes les N heures"

#: build/editor.js:8 src/editor/index.js:322
msgid "Once"
msgstr "Une seule fois"

#: build/editor.js:8 src/editor/index.js:335
msgid "Hours between displays"
msgstr "Heures entre deux affichages"

#: build/editor.js:8 src/editor/index.js:336
msgid "Inactivity minutes before a new visit"
msgstr "Minutes d'inactivité avant une nouvelle visite"

#: build/editor.js:8 src/editor/index.js:352
msgid "Conversion selector (optional)"
msgstr "Sélecteur de conversion (facultatif)"

#: build/editor.js:8 src/editor/index.js:353
msgid ""
"CSS selector: once it appears inside the popup, the popup is never shown "
"again to that visitor."
msgstr ""
"Sélecteur CSS : dès qu'il apparaît dans la fenêtre, celle-ci n'est plus "
"jamais montrée à ce visiteur."

#: build/public.js:1 src/public/index.js:653
msgid "Close test"
msgstr "Fermer le test"

#: build/public.js:1 src/public/index.js:678
msgid "Opening…"
msgstr "Ouverture…"

#: build/public.js:1 src/public/index.js:684
msgid "Now: move the mouse out of the window, towards the top"
msgstr "Maintenant : sortez la souris de la fenêtre, vers le haut"

#: build/public.js:1 src/public/index.js:689
msgid "Exit intent only works on a desktop computer with a mouse."
msgstr ""
"L'intention de sortie ne fonctionne que sur un ordinateur avec une souris."

#: build/public.js:1 src/public/index.js:695
msgid "Now: scroll, click or press a key"
msgstr "Maintenant : faites défiler, cliquez ou appuyez sur une touche"

#: build/public.js:1 src/public/index.js:736
msgid "Popup closed. Reload the page to test again, or close this test."
msgstr ""
"Fenêtre fermée. Rechargez la page pour la tester à nouveau, ou fermez ce "
"test."

#: build/public.js:1 src/public/index.js:740
msgid "Popup closed. Trigger it again or close this test."
msgstr "Fenêtre fermée. Déclenchez-la à nouveau ou fermez ce test."

#. translators: 1: sentence describing the popup's trigger and delay, 2: number of seconds left before it can trigger.
#: build/public.js:2 src/public/index.js:708
msgid "Test mode: %1$s Waiting %2$d s…"
msgstr "Mode test : %1$s Attente : %2$d s…"
